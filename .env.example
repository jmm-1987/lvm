# Copia este archivo a .env y rellena los valores.
# cp .env.example .env

# Clave secreta de Flask (genera una aleatoria larga)
SECRET_KEY=pon_aqui_una_clave_secreta_larga_y_unica

# Base de datos (SQLite por defecto; en producción puede ser la misma ruta)
DATABASE_URL=sqlite:///app.db

# Bot de Telegram (obtener en @BotFather)
TELEGRAM_BOT_TOKEN=

# API de OpenAI (obtener en https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Contraseña de acceso a la aplicación (usuario: lvm)
LVM_PASSWORD=

# URL pública de la aplicación (para el webhook del bot)
# Desarrollo: http://localhost:5000
# Producción: https://tu-dominio.com
FLASK_APP_URL=http://localhost:5000
